<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A1A"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 ПОДКЛЮЧИТЬ" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="Не подключено"
            android:textColor="#888888" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.example.lbsttcontroller.JoystickView
            android:id="@+id/joystickLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp" />

        <com.example.lbsttcontroller.JoystickView
            android:id="@+id/joystickRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnStabilize"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Stabilize" />
        <Button android:id="@+id/btnAltHold"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="AltHold" />
        <Button android:id="@+id/btnLoiter"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Loiter" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#1A1A3A"
        android:text="ALT: -- | SPD: -- | BAT: --"
        android:textColor="#00FF88"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📡 Broadcast: выключен"
        android:textColor="#666666" />
</LinearLayout>